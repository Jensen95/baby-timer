PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
PUBLIC_BUGSINK_DSN=

# Override the base URL used for post-login redirects (magic link + device-link exchange).
# Set this in .env.local when testing locally so the redirect targets your dev server
# instead of the production origin configured in Supabase. Leave blank in production.
# Example: PUBLIC_APP_REDIRECT_URL=http://localhost:5173
PUBLIC_APP_REDIRECT_URL=

# Sourcemap upload (optional — only needed to upload sourcemaps during build)
# BUGSINK_URL=https://your-instance.bugsink.com
# BUGSINK_AUTH_TOKEN=
# BUGSINK_ORG=sentry
# BUGSINK_PROJECT=baby-timer
